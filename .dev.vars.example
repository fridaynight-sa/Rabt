# Copy to .dev.vars for `npm run preview` (Cloudflare). Never commit real values.

# Supabase project (Project Settings > API keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Full database access: keep it secret.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public address of the site (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bot check on sign up and login (Cloudflare Turnstile, free). Optional locally.
# The secret key goes in Supabase: Authentication > Attack Protection > Captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Shown on the terms and privacy pages. Optional.
NEXT_PUBLIC_CONTACT_EMAIL=
