{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rabt",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Images are in Supabase Storage. To move them to Cloudflare R2 later: create the bucket
  // "rabt-media", add this binding back, and set NEXT_PUBLIC_IMAGE_STORAGE=r2 (docs/ARCHITECTURE.md).
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "rabt-media" }],
  "observability": {
    "enabled": true,
  },
}
